# Copy to backend/.env. Read by `just` and by bin/ui-box-wake and
# bin/ui-box-idle-stop, which need TF_VAR_storage_path to find the state share.
#
# This belongs on archie, at /home/fredrir/packages/ui-box/backend/.env. The
# lifecycle verbs drive libvirt, and libvirt is there — on the Mac every one of
# them fails at the connection below. Get the tools with `nix develop .#backend`.

TF_PLUGIN_CACHE_DIR="$HOME/.cache/tofu-plugins"

TF_VAR_libvirt_uri="qemu:///system"

# Mandatory: outside the repo. A path: flake reference copies its whole root
# into the nix store verbatim and .gitignore has no say in it, so a 100 GiB
# qcow2 under the checkout would be copied on every evaluation. distro-lab can
# keep its images in its own checkout because nothing references it as a flake
# path; this repo is exactly what distro-lab's flake pulls in that way.
TF_VAR_storage_path="/home/fredrir/ui-box-state"

# ui-box declares this pool itself, at $TF_VAR_storage_path/images. distro-lab
# owns the `images` pool on the same host; do not point this at it.
TF_VAR_pool="ui-box"

# Referenced by name only. distro-lab's shared stack owns this network object,
# its DHCP reservations and its DNS entries, and ui-box-backend is in none of
# them — the image carries the static 192.168.123.60 that puts it on the wire.
TF_VAR_network="dlab"

# Not a TF_VAR: the guest account is set by backend/nixos, and `User fredrir`
# by the fragments in backend/ssh. Recorded here so the contract is in one
# place. The account is `fredrir`.
