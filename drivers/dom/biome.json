{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": { "ignore": ["dist/**", "node_modules/**"] },
  "organizeImports": { "enabled": true },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noExplicitAny": "off", "noAssignInExpressions": "off" },
      "complexity": { "noForEach": "off", "noExcessiveCognitiveComplexity": "off" },
      "style": { "noNonNullAssertion": "off", "useNodejsImportProtocol": "error" },
      "performance": { "noDelete": "off" }
    }
  }
}
